# Base URL the frontend calls. Every request is relative to it (e.g. `/users`),
# so it must end in /api.
#
# - Dev (npm run dev):     /api          -> goes through the Vite proxy
# - Docker Compose:        /api          -> nginx proxies same-origin
# - Cloud (Render, etc.):  https://<your-backend-host>/api
#
# Vite inlines this at BUILD time. For the Docker image, pass it as a build arg
# (--build-arg VITE_API_URL=...); Render's Web Service reads it from the
# service environment automatically.
VITE_API_URL=/api
