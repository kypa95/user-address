# Variables que Docker Compose sustituye en docker-compose.yml.
# Todas tienen default en el compose, así que este archivo es opcional:
# sirve para cambiar credenciales sin tocar el YAML.
#
#   cp .env.example .env
#
# OJO: Postgres solo aplica estas credenciales en la PRIMERA inicialización
# del volumen. Si las cambias después, hay que `docker compose down -v`.

POSTGRES_DB=user_address_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# URL base que llama el frontend. Vite la hornea en BUILD time.
# En Compose va relativa: nginx hace proxy same-origin.
VITE_API_URL=/api
